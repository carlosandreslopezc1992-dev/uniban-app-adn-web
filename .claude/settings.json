{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(node --check *)",
      "Bash(clasp status)",
      "Bash(clasp deployments)",
      "Bash(git -C ../uniban-app-adn status*)",
      "Bash(git -C ../uniban-app-adn log*)",
      "Bash(git -C ../uniban-app-adn diff*)",
      "Bash(git -C ../uniban-app-adn show*)",
      "Bash(git -C ../uniban-app-adn ls-remote*)",
      "Bash(git -C ../uniban-app-adn-web status*)",
      "Bash(git -C ../uniban-app-adn-web log*)",
      "Bash(git -C ../uniban-app-adn-web diff*)",
      "Bash(git -C ../uniban-app-adn-web show*)",
      "Bash(git -C ../uniban-app-adn-web ls-remote*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(clasp push)",
      "Bash(clasp push *)",
      "Bash(clasp deploy)",
      "Bash(clasp deploy *)",
      "Bash(npm install)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git clean*)"
    ],
    "additionalDirectories": [
      "../uniban-app-adn"
    ]
  }
}
